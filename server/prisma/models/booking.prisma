model BookingInventoryItem {
  id              String @id @default(cuid())
  tenantId        String
  bookingId       String
  inventoryItemId String?

  booking       Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  role String @default("PRIMARY")

  itemCategorySnapshot InventoryCategory
  itemLabelSnapshot    String
  itemSizeValueSnapshot Decimal? @db.Decimal(10, 2)
  itemSizeUnitSnapshot  InventoryUnit?
  itemSerialSnapshot    String?

  basePriceSnapshot     Decimal @db.Decimal(10, 2)
  concretePriceSnapshot Decimal @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, bookingId])
  @@index([tenantId, inventoryItemId])
  @@index([bookingId])
  @@index([inventoryItemId])
}

model BookingAddon {
  id        String @id @default(cuid())
  tenantId  String
  bookingId String
  addonId   String?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addon   Addon?  @relation(fields: [addonId], references: [id], onDelete: SetNull)

  addonCodeSnapshot  String
  addonNameSnapshot  String
  addonPriceSnapshot Decimal @db.Decimal(10, 2)
  addonPriceTypeSnapshot AddonPriceType @default(FLAT)

  quantity  Int     @default(1)
  lineTotal Decimal @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, bookingId])
  @@index([tenantId, addonId])
  @@index([bookingId])
  @@index([addonId])
}

model BookingNote {
  id       String @id @default(cuid())
  tenantId String

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  visibility NoteVisibility  @default(INTERNAL)
  type       BookingNoteType @default(NOTE)

  title String?
  body  String

  // Who wrote it. authorUserId is null for system notes and old rows.
  authorType   BookingActorType @default(ADMIN)
  authorUserId String?
  authorUser   User?            @relation("BookingNoteAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorLabel  String?

  // Change / reschedule requests only.
  requestStatus              BookingNoteRequestStatus?
  requestedDeliveryDate      DateTime?                 @db.Date
  requestedPickupDate        DateTime?                 @db.Date
  requestedPickupDateUnknown Boolean?
  resolvedAt                 DateTime?
  resolvedByUserId           String?
  resolvedBy                 User?                     @relation("BookingNoteResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  resolutionNote             String?

  views BookingNoteView[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, bookingId])
  @@index([bookingId])
  @@index([visibility])
  @@index([tenantId, requestStatus])
  @@index([authorUserId])
}

// Read receipts: one row per user per note, the first time they open it.
model BookingNoteView {
  id       String @id @default(cuid())
  tenantId String

  noteId String
  note   BookingNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  viewedAt DateTime @default(now())

  @@unique([noteId, userId])
  @@index([tenantId])
  @@index([userId])
}

model BookingHistory {
  id       String @id @default(cuid())
  tenantId String

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  eventType  String
  actorType  BookingActorType
  actorLabel String?

  summary  String
  metadata Json?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, bookingId])
  @@index([tenantId, eventType])
  @@index([bookingId])
  @@index([eventType])
  @@index([createdAt])
}

model Booking {
  id       String @id @default(cuid())
  tenantId String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  bookingNumber String

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  serviceType ServiceType @default(DUMPSTER_RENTAL)
  projectType String?

  fulfillmentType FulfillmentType @default(DELIVERY)
  source          BookingSource   @default(WEB)

  // Debris type from the booking form (e.g. "household", "concrete").
  // Heavy materials add the item's concretePrice as materialFee.
  material String?

  // Admin who created it (ADMIN / PHONE bookings).
  createdByUserId String?
  createdBy       User?   @relation("BookingCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  customerName  String
  customerPhone String
  customerEmail String?

  clientType ClientType @default(INDIVIDUAL)

  businessName  String?
  businessPhone String?
  businessEmail String?

  // Job-site address. Required for DELIVERY (enforced by the server).
  address1 String?
  address2 String?
  city     String?
  state    String?
  zip      String?

  latitude              Decimal? @db.Decimal(10, 7)
  longitude             Decimal? @db.Decimal(10, 7)
  distanceFromWarehouse Decimal? @db.Decimal(10, 2)

  placement                String?
  instructions             String?
  customerNotes            String?
  locationVerified         Boolean @default(false)
  locationVerificationNote String?

  timezone String @default("America/Denver")

  deliveryDate DateTime @db.Date
  pickupDate   DateTime? @db.Date

  pickupDateUnknown Boolean @default(false)
  rentalDaysIncluded Int     @default(7)

  priorityDelivery     Boolean   @default(false)
  deliveryTime         DateTime?
  priorityDeliveryNote String?

  bookingStatus BookingStatus @default(QUOTE)
  paymentStatus PaymentStatus @default(UNPAID)

  stripePaymentIntentId String? @unique
  stripePaymentStatus   String?

  paidAt      DateTime?
  confirmedAt DateTime?

  // Price lines. Rates are snapshots of the tenant/item rules at booking time.
  basePrice           Decimal @db.Decimal(10, 2)
  deliveryFee         Decimal @default(0) @db.Decimal(10, 2)
  billableMiles       Decimal @default(0) @db.Decimal(10, 2)
  perMileRate         Decimal @default(0) @db.Decimal(10, 2)
  mileageFee          Decimal @default(0) @db.Decimal(10, 2)
  priorityDeliveryFee Decimal @default(0) @db.Decimal(10, 2)
  extraDays           Int     @default(0)
  extraDayRate        Decimal @default(0) @db.Decimal(10, 2)
  extraDaysFee        Decimal @default(0) @db.Decimal(10, 2)
  materialFee         Decimal @default(0) @db.Decimal(10, 2)
  overageFee          Decimal @default(0) @db.Decimal(10, 2)
  addonsTotal         Decimal @default(0) @db.Decimal(10, 2)

  // subtotal = sum of lines - discount; total = subtotal + tax.
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  discountReason String?
  subtotal       Decimal @default(0) @db.Decimal(10, 2)
  taxRate        Decimal @default(0) @db.Decimal(6, 5)
  taxAmount      Decimal @default(0) @db.Decimal(10, 2)
  total          Decimal @db.Decimal(10, 2)

  quotedAt    DateTime?
  scheduledAt DateTime?
  deliveredAt DateTime?
  pickedUpAt  DateTime?
  cancelledAt DateTime?
  completedAt DateTime?

  cancellationReason String?

  inventoryItems BookingInventoryItem[]

  addons   BookingAddon[]
  notes    BookingNote[]
  history  BookingHistory[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, bookingNumber])
  @@index([tenantId])
  @@index([clientId])
  @@index([tenantId, clientId])
  @@index([bookingStatus])
  @@index([tenantId, bookingStatus])
  @@index([paymentStatus])
  @@index([tenantId, paymentStatus])
  @@index([deliveryDate])
  @@index([tenantId, deliveryDate])
  @@index([pickupDate])
  @@index([tenantId, pickupDate])
  @@index([serviceType])
  @@index([tenantId, serviceType])
  @@index([customerEmail])
  @@index([tenantId, customerEmail])
  @@index([bookingNumber])
  @@index([zip])
  @@index([createdByUserId])
}