// Express session store (connect-pg-simple, see src/app.ts).
// Modeled here only so Prisma migrations track the table; the app reads and
// writes it through connect-pg-simple, not Prisma.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}
