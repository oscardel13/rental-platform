{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",

    "noEmit": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,

    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts", "src/types/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
