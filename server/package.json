{
  "name": "iron-peak-services-server",
  "version": "1.0.0",
  "description": "Iron Preak Services Server",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "tsx src/server.ts",
    "watch": "nodemon --exec tsx src/server.ts",
    "db:start": "docker run -d --name ironpeak-postgres -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=ironpeak -p 5432:5432 postgres:16",
    "db:stop": "docker stop ironpeak-postgres",
    "db:logs": "docker logs -f ironpeak-postgres",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "stripe:listen": "stripe listen --forward-to localhost:8000/stripe/webhook"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-session": "^2.0.49",
    "@types/cors": "^2.8.19",
    "@types/express-session": "^1.19.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^8.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pg": "^8.18.0",
    "dotenv": "^17.3.1",
    "nodemon": "^3.1.14",
    "prisma": "^7.6.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.5.0",
    "@types/express": "^5.0.6",
    "connect-pg-simple": "^10.0.0",
    "cookie-session": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.22.0",
    "stripe": "^22.3.2"
  }
}
